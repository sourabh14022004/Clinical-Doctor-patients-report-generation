  "hindi_text": "\u0928\u092e\u0938\u094d\u0924\u0947 \u092e\u0947\u0930\u0947 \u0928\u093e\u092e \u0926\u094b\u0915\u094d\u0924\u0930 \u0938\u0941\u0930\u094d\u0921\u093f\u0928\u094d\u092e\u093e\u092f, \u092e\u0948\u0902 \u0906\u092a \u0938\u0947 \u0915\u0941\u091b \u092a\u0941\u0937\u0928 \u092a\u0941\u0937\u0928\u093e \u091a\u093e\u0942\u0902\u0917\u0940, \u0905\u092a\u0915\u093e \u0928\u093e\u092e? \u0924\u094b\u0915\u094d\u0924\u0930 \u092a\u094d\u0930\u0935\u093f\u0916\u0941 \u092e\u093e\u0936\u0930\u094d\u092e\u093e. \u0905\u092a\u0915\u0940 \u0909\u092e\u094d\u0930\u0941? \u0924\u092c\u094d\u091f\u0940. \u0905\u092a\u0915\u093e \u0926\u0947\u091f \u0905\u092a \u092a\u0930\u094d\u0925? \u0924\u0940\u0928 \u090f\u0915 \u0928\u093e\u0907\u0902\u091f\u093f\u092b\u093e\u0908\u0917. \u0905\u092a\u0928\u0947 \u092a\u0921\u093c\u093e\u0908 \u0915\u0939\u093e\u0901 \u0924\u0915 \u0915\u0940 \u0939\u0948? \u0924\u0930\u0947 \u0906\u092e\u092d\u0947 \u092d\u0947\u0938 \u0915\u092e\u094d\u092a\u094d\u0932\u093f\u091f \u0939\u0948 \u0905\u092d\u0940 \u092a\u0940\u091c\u0940 \u091c\u0947\u092f\u093e \u0914\u0930 \u0915\u092e\u094d\u092e\u093f\u0932\u093f\u091f\u0940 \u092e\u0948\u091f\u0947\u0938\u0947\u0928\u0964 \u0905\u092a \u0915\u093e\u092e \u0915\u094d\u092f\u093e \u0915\u0930\u0924\u0947 \u0939\u0948? \u0905\u092d\u0940 \u0915\u092e\u094d\u092e\u093f\u0932\u093f\u091f\u0940 \u092e\u0948\u091f\u0947\u0938\u0947\u0928\u0964 \u092d\u0947 \u091c\u0947\u092f\u093e\u0930\u094d\u0937\u093f\u092a \u0905\u092a \u0936\u093e\u0926\u0940 \u0936\u0941\u0926 \u0939\u0948? \u0928\u0939\u0940\u0902 \u0905\u092a\u0915\u093e \u092a\u0924\u093e \u0915\u094d\u092f\u093e \u0939\u0948? \u0905\u092a\u0915\u093e \u092c\u0930\u0947\u0932\u0940 \u0915\u0930 \u0939\u0948 \u0928\u0935\u0930\u093e \u092e\u0941\u091d\u093e \u0905\u092a\u0915\u0940 \u092a\u093f\u0924\u093e \u0915\u093e \u0928\u093e\u092e? \u092c\u092c\u0935\u093e\u0901\u0928 \u0926\u093e\u0936\u094d\u0935\u0932\u094d\u092e\u093e \u092e\u092c\u093e\u092f\u0932 \u0928\u092e\u094d\u092c\u0932? \u0928\u093e\u0908 \u0927\u0935\u0932 \u092b\u093c\u093e\u0907\u092b, \u0938\u092c\u0928 \u092b\u094d\u0930\u0940 \u090f\u091f, \u0928\u0935\u0930 \u092b\u094d\u0930\u0940 \u092b\u094d\u0930\u0940 \u092c\u0935\u0928 \u0905\u092a\u0915\u0940 \u092e\u0902\u0920\u094d\u0932\u0940 \u0905\u092a\u0915\u093e \u0915\u093f\u0924\u0928\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948? \u092a\u093f\u0938, \u090f\u0915 \u0932\u093e\u0917\u094d \u0905\u092a\u0928\u0947 \u0915\u093f\u0938\u094d\u091f\u0940 \u092d\u0940 \u0917\u0935\u0930\u094d\u0935\u0947\u0902 \u0915\u0940 \u0915\u094b\u0908 \u0906\u091c\u0940 \u0938\u094d\u0915\u0940\u092e \u091c\u094b \u0938\u0947 \u0906\u091c\u0940\u0936\u094d\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u0915\u0939\u0940 \u092d\u0940 \u090f\u0928 \u0930\u094b\u0932 \u0915\u0930 \u0939\u0948? \u0928\u0939\u0940\u0902 \u0905\u092a\u0915\u093e \u0935\u0947\u091f? \u092b\u093f\u092b, \u0924\u0940 \u090f\u091f \u0905\u092a\u0915\u0940 \u0939\u093e\u0908\u091f? \u0928\u0935\u0930 \u092b\u093c\u093e\u0907\u091f \u0905\u092a\u0915\u094b \u0915\u092d\u0940 \u092a\u0939\u0932\u0947 \u0915\u0941\u0908 \u0932\u0902\u092d\u0940 \u0935\u093f\u092e\u093e\u0930\u0940 \u0930\u0939\u0940 \u0939\u094b, \u092f\u0947 \u0938\u0947 \u0926\u093e\u090f\u092c\u093f\u091f\u0940, \u092c\u0940\u092a\u0940, \u0936\u0941\u0930\u094d\u0921\u0930, \u0905\u092a\u0928\u0947 \u0915\u092d\u0940 \u0915\u093f\u0938\u094d\u091f\u0940 \u092d\u0940 \u0916\u0923\u0938\u0930 \u0915\u0947 \u091c\u093e\u091c \u0915\u0930 \u0906\u0908\u090f, \u0938\u0930\u0935\u093e\u090f\u0915\u0932, \u092c\u094d\u0930\u0948\u0938\u094d\u091f, \u0914\u0930\u0932 \u0917\u0930 \u092e\u0947\u0902 \u0915\u093f\u0938\u094d\u091f\u0940 \u0915\u094b \u092d\u0940 \u0915\u092d\u0940 \u092b\u094d\u092f\u093e\u092e\u094d\u0921\u0940 \u092e\u0947\u0902 \u0916\u0923\u0938\u0930? \u092e\u092e\u094d\u092e\u0947 \u0915\u094b \u0915\u093f\u0938\u094d\u091f\u0940 \u0936\u094d\u0915\u093e? \u0905\u092a\u0928\u0947 \u0915\u092d\u0940 \u0924\u092e\u093e\u0915\u0941 \u0915\u093e \u0938\u0947\u0935\u0928 \u0915\u093f\u092f\u093e \u0939\u0948, \u0924\u092e\u093e\u0915\u0941 \u0905\u0932\u0915\u094b\u0932? \u0928\u0939\u0940\u0902 \u0905\u092a\u0928\u0947 \u0915\u092d\u0940 \u092c\u0940 \u0924\u092e\u093e\u0915\u0941 \u0915\u093e \u0938\u0947\u0935\u0928 \u0915\u093f\u092f\u093e \u0939\u0948? \u0928\u0939\u0940\u0902 \u0905\u092a \u0936\u093e\u0915\u093e \u0939\u093e\u0930\u0940 \u0939\u0948, \u092f\u093e \u092e\u093f\u0915\u094d\u0938 \u0932\u0947\u0924\u0947 \u0939\u0948? \u0936\u093e\u0915\u093e \u0939\u093e\u0930\u0940 \u0905\u092a \u0936\u093e\u0930\u0921\u093f\u0915 \u0915\u094d\u092f\u093e \u091c\u0940? \u0935\u093f\u0938\u093f\u0915\u0932 \u0905\u0915\u094d\u091f\u093f\u090f \u0905\u092a \u0915\u093f\u0924\u0928\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948, \u0930\u094b\u0938 \u092e\u0930\u094d\u0930\u093e\u092e \u0939\u0948 \u0930\u094b\u0938 \u090f\u0915 \u0917\u0921\u093c\u093e \u090f\u0915 \u0917\u0921\u093c\u093e \u0905\u092a \u092e\u0948\u0902 \u0915\u0941\u091b \u0916\u0902\u0938\u0930 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u091f\u0947\u091f \u0915\u094b\u0908 \u0938\u093f\u092e\u094d\u091f\u092e\u094d\u0938 \u0939\u094b\u0924\u0947 \u0939\u0948, \u0909\u0902\u0915\u0947 \u0930\u093f\u091f\u0947\u091f \u0915\u0941\u091b\u0928 \u0915\u0941\u091b\u0928 \u092a\u0941\u0937\u0928 \u091a\u093e\u0901\u0902\u0917\u0940 \u0905\u092a\u0915\u093e \u0935\u091c\u0928 \u092a\u093f\u0937\u094d\u0932\u0947 \u091a\u0947 \u092e\u0947\u0902\u0917\u0947 \u092e\u0947\u0902 \u0915\u092d\u0940 \u0915\u092e \u0939\u0942\u0901? \u0928\u0939\u0940\u0902 \u092a\u093f\u0937\u094d\u0932\u0947 \u091a\u0947 \u092e\u0947\u0902\u0917\u0947 \u092e\u0947\u0902 \u0906\u092a\u0942 \u092d\u0941\u0916\u093e\u0930 \u092f\u0926\u094d\u0916\u093e\u0928 \u0930\u0939\u0940 \u0939\u0942\u0901? \u0928\u0939\u0940\u0902 \u0915\u0941\u0908 \u0906\u0901\u0938\u093e \u0917\u093e\u0913 \u0936\u0930\u0940\u0930 \u092e\u0947\u0902 \u091c\u094b \u0932\u0902\u092d\u0947 \u0938\u092e\u0925\u0915\u094b \u0914\u0930 \u0924\u0940\u0916 \u0928\u0939\u0942\u0901? \u0928\u0939\u0940\u0902 \u0936\u0930\u0940\u0930 \u092e\u0947\u0902 \u0915\u0939\u0940 \u092a\u0930 \u0917\u093e\u0902\u091f \u092a\u093f\u0937\u094d\u0932\u0947 \u091a\u0947 \u092e\u0947\u0902\u0917\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0926\u0930\u094d\u0927 \u092a\u0942 \u0915\u093f\u0938\u0940 \u0915\u093e\u0930\u0928 \u0915\u093f\u0938\u0940 \u092c\u091c\u091c\u093c \u0938\u0947 \u0905\u092a\u0915\u094b \u0930\u0939\u093e \u0939\u0942\u0901? \u0928\u0939\u0940\u0902 \u0906\u0938\u0947 \u092e\u0947\u0902\u0917\u0947 \u092a\u0941\u091b \u0936\u0930\u0940\u0930 \u0915\u093f\u0938\u0940 \u092c\u0940\u0937 \u091c\u0917\u092f \u0938\u0947 \u0906\u092a\u0915\u094b \u092a\u0942\u0930 \u0928\u093f\u0915\u0932\u093e\u0913 \u092a\u093f\u0937\u094d\u0932\u0947 \u091a\u0947 \u092e\u0947\u0902\u0917\u0947 \u092e\u0947\u0902 \u0932\u0902\u092d\u0947 \u0938\u092e\u0925\u0915\u0940 \u092e\u093e\u0930\u0940 \u0924\u094b \u0905\u092a\u0915\u094b \u0928\u0939\u0940\u0902 \u092e\u0941\u0917 \u0916\u094b\u0932\u0947 \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u0915\u092d\u0940 \u0924\u0915\u094d\u0932\u0940\u092b \u0930\u0939\u0940 \u0939\u0942\u0901? \u092e\u0941\u091d \u092e\u0947\u0902 \u0932\u093e\u0932 \u092f\u093e \u0938\u092a\u093f\u0925\u0915\u0932\u093e\u0913 \u0915\u093e \u0917\u093e\u0913 \u0915\u0941\u0908 \u0906\u0938\u093e \u0917\u093e\u0913 \u092e\u0941\u091d \u092e\u0947\u0902 \u091c\u094b \u092a\u093f\u0937\u094d\u0932\u0947 \u0921\u094b \u0939\u092c\u0924\u0947 \u092e\u0947\u0902 \u0915\u092d\u0940 \u0920\u0940\u0915 \u0928\u0939\u0942\u0901? \u0928\u0939\u0940\u0902 \u0915\u092d\u0940 \u091a\u092c \u0906\u0928\u0947 \u092e\u0947\u0902 \u092f\u093e\u0938\u0947 \u0915\u094b \u0926\u093f\u0915\u0926 \u0930\u0939\u0940 \u0939\u0942\u0901? \u0906\u092a\