				"to": "00:00:05,000"
			},
			"offsets": {
				"from": 2960,
				"to": 5000
			},
			"text": " मैं आप से पुट सवाल पुषने चात्ती हूँ"
		},
		{
			"timestamps": {
				"from": "00:00:05,000",
				"to": "00:00:07,000"
			},
			"offsets": {
				"from": 5000,
				"to": 7000
			},
			"text": " आपका नाम क्या है"
		},
		{
			"timestamps": {
				"from": "00:00:07,000",
				"to": "00:00:08,000"
			},
			"offsets": {
				"from": 7000,
				"to": 8000
			},
			"text": " स्वाईदे माँ"
		},
		{
			"timestamps": {
				"from": "00:00:08,000",
				"to": "00:00:09,000"
			},
			"offsets": {
				"from": 8000,
				"to": 9000
			},
			"text": " और आपकी उमर"
		},
		{
			"timestamps": {
				"from": "00:00:09,000",
				"to": "00:00:10,000"
			},
			"offsets": {
				"from": 9000,
				"to": 10000
			},
			"text": " तीस"
		},
		{
			"timestamps": {
				"from": "00:00:10,000",
				"to": "00:00:13,000"
			},
			"offsets": {
				"from": 10000,
				"to": 13000
			},
			"text": " और आपकी देट अप बर्थ क्या है"
		},
		{
			"timestamps": {
				"from": "00:00:13,000",
				"to": "00:00:15,000"
			},
			"offsets": {
				"from": 13000,
				"to": 15000
			},
			"text": " तीस, पाज, नान्टी, नान्टी, पाईप"
		},
		{
			"timestamps": {
				"from": "00:00:15,000",
				"to": "00:00:17,000"
			},
			"offsets": {
				"from": 15000,
				"to": 17000
			},
			"text": " अपने कहतक पड़ाय करी है?"
		},
		{
			"timestamps": {
				"from": "00:00:17,000",
				"to": "00:00:19,000"
			},
			"offsets": {
				"from": 17000,
				"to": 19000
			},
			"text": " मैंने MBS क्या हूँ है?"
		},
		{
			"timestamps": {
				"from": "00:00:19,000",
				"to": "00:00:21,000"
			},
			"offsets": {
				"from": 19000,
				"to": 21000
			},
			"text": " अब यह आप यह आप क्या जोब कर रहा है?"
		},
		{
			"timestamps": {
				"from": "00:00:21,000",
				"to": "00:00:23,000"
			},
			"offsets": {
				"from": 21000,
				"to": 23000
			},
			"text": " मैं PGJ आरु, कमुटिमेशन धिपार्ट्में मैं"
