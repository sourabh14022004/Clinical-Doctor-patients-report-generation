			"timestamps": {
				"from": "00:01:54,000",
				"to": "00:01:57,000"
			},
			"offsets": {
				"from": 114000,
				"to": 117000
			},
			"text": " अप शाका हारी है, मासा हारी है"
		},
		{
			"timestamps": {
				"from": "00:01:57,000",
				"to": "00:02:08,000"
