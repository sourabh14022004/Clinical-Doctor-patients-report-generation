			"timestamps": {
				"from": "00:00:38,000",
				"to": "00:00:40,000"
			},
			"offsets": {
				"from": 38000,
				"to": 40000
			},
			"text": " अपनी किस्टी बी गवर्में स्कीम में अन्रोल कराया"
