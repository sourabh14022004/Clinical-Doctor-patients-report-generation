		},
		{
			"timestamps": {
				"from": "00:01:42,000",
				"to": "00:01:43,000"
			},
			"offsets": {
				"from": 102000,
				"to": 103000
			},
			"text": " किस्टी श्का?"
		},
		{
			"timestamps": {
				"from": "00:01:43,000",
				"to": "00:01:51,000"
			},
			"offsets": {
				"from": 103000,
				"to": 111000
			},
			"text": " अपने कभी तमाकु का सेवन किया है, तमाकु अलकोल?"
		},
		{
			"timestamps": {
				"from": "00:01:51,000",
				"to": "00:01:52,000"
			},
			"offsets": {
				"from": 111000,
				"to": 112000
			},
			"text": " नहीं"
		},
		{
			"timestamps": {
				"from": "00:01:57,000",
				"to": "00:02:00,000"
			},
			"offsets": {
				"from": 117000,
				"to": 120000
			},
			"text": " अपने कभी बी तमाकु का सेवन किया है?"
		},
		{
			"timestamps": {
				"from": "00:02:00,000",
				"to": "00:02:01,000"
			},
			"offsets": {
				"from": 120000,
				"to": 121000
			},
			"text": " नहीं"
		},
		{
			"timestamps": {
				"from": "00:02:02,000",
				"to": "00:02:05,000"
			},
			"offsets": {
				"from": 122000,
				"to": 125000
			},
			"text": " अप शाका हारी है, या मिक्स लेते है?"
		},
		{
			"timestamps": {
				"from": "00:02:05,000",
				"to": "00:02:06,000"
			},
			"offsets": {
				"from": 125000,
				"to": 126000
			},
			"text": " शाका हारी"
		},
		{
			"timestamps": {
				"from": "00:02:09,000",
				"to": "00:02:10,000"
			},
			"offsets": {
				"from": 129000,
				"to": 130000
			},
			"text": " अप शारडिक"
		},
		{
			"timestamps": {
				"from": "00:02:14,000",
				"to": "00:02:15,000"
			},
			"offsets": {
				"from": 134000,
				"to": 135000
			},
			"text": " क्या जी?"
		},
		{
			"timestamps": {
				"from": "00:02:16,000",
				"to": "00:02:19,000"
			},
			"offsets": {
				"from": 136000,
				"to": 139000
			},
			"text": " विसिकल अक्टिए अप कितनी करते है, रोस मर्राम है"
		},
		{
			"timestamps": {
				"from": "00:02:19,000",
				"to": "00:02:20,000"
			},
			"offsets": {
				"from": 139000,
				"to": 140000
			},
			"text": " रोस एक गड़ा"
		},
		{
			"timestamps": {
				"from": "00:02:20,000",
				"to": "00:02:21,000"
			},
			"offsets": {
				"from": 140000,
				"to": 141000
			},
			"text": " एक गड़ा"
		},
		{
			"timestamps": {
				"from": "00:02:25,000",
				"to": "00:02:31,000"
			},
			"offsets": {
				"from": 145000,
				"to": 151000
			},
			"text": " अप मैं कुछ खंसर के लिए रिटेट कोई सिम्टम्स होते है, उंके रिटेट कुछन कुछन पुषन चाँंगी"
		},
		{
			"timestamps": {
				"from": "00:02:31,000",
				"to": "00:02:34,000"
			},
			"offsets": {
				"from": 151000,
				"to": 154000
			},
			"text": " अपका वजन पिष्ले चे मेंगे में कभी कम हूँ?"
		},
		{
			"timestamps": {
				"from": "00:02:34,000",
				"to": "00:02:35,000"
			},
			"offsets": {
				"from": 154000,
				"to": 155000
			},
			"text": " नहीं"
		},
		{
			"timestamps": {
				"from": "00:02:36,000",
				"to": "00:02:40,000"
			},
			"offsets": {
				"from": 156000,
				"to": 160000
			},
			"text": " पिष्ले चे मेंगे में आपू भुखार यद्खान रही हूँ?"
		},
		{
			"timestamps": {
				"from": "00:02:40,000",
				"to": "00:02:41,000"
			},
			"offsets": {
				"from": 160000,
				"to": 161000
			},
			"text": " नहीं"
		},
		{
			"timestamps": {
				"from": "00:02:41,000",
				"to": "00:02:46,000"
			},
			"offsets": {
				"from": 161000,
				"to": 166000
			},
			"text": " कुई आँसा गाओ शरीर में जो लंभे समथको और तीख नहूँ?"
		},
		{
			"timestamps": {
				"from": "00:02:46,000",
				"to": "00:02:47,000"
			},
			"offsets": {
				"from": 166000,
				"to": 167000
			},
			"text": " नहीं"
		},
		{
			"timestamps": {
				"from": "00:02:48,000",
				"to": "00:02:54,000"
			},
			"offsets": {
				"from": 168000,
				"to": 174000
			},
			"text": " शरीर में कही पर गांट पिष्ले चे मेंगे में नहीं"
		},
		{
			"timestamps": {
				"from": "00:02:55,000",
				"to": "00:02:59,000"
			},
			"offsets": {
				"from": 175000,
				"to": 179000
			},
			"text": " दर्ध पू किसी कारन किसी बजज़ से अपको रहा हूँ?"
		},
		{
			"timestamps": {
				"from": "00:02:59,000",
				"to": "00:03:01,000"
			},
			"offsets": {
				"from": 179000,
				"to": 181000
			},
			"text": " नहीं आसे मेंगे पुछ"
		},
		{
			"timestamps": {
				"from": "00:03:02,000",
				"to": "00:03:07,000"
			},
			"offsets": {
				"from": 182000,
				"to": 187000
			},
			"text": " शरीर किसी बीष जगय से आपको पूर निकलाओ पिष्ले चे मेंगे में"
		},
		{
			"timestamps": {
				"from": "00:03:08,000",
				"to": "00:03:10,000"
			},
			"offsets": {
				"from": 188000,
				"to": 190000
			},
			"text": " लंभे समथकी मारी तो अपको नहीं"
		},
